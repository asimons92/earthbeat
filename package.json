{
  "name": "earthbeat_2",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter server dev",
    "dev:client": "pnpm --dir client dev",
    "dev:server": "pnpm --dir server dev",
    "build": "pnpm --dir client build && pnpm --dir server build",
    "start": "pnpm --dir server start",
    "migrate": "pnpm --dir server migrate",
    "test": "pnpm --dir client test",
    "lint": "pnpm --dir client lint"
  }
}
