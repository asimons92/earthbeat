{
  "name": "earthbeat",
  "generators": [
    "./generators/ui-catalog"
  ],
  "model": {
    "catalog": {
      "shell": {
        "createActions": [
          {
            "key": "addConnector",
            "label": "New connector",
            "nodeType": "connector"
          },
          {
            "key": "addModulator",
            "label": "New modulator",
            "nodeType": "modulator"
          },
          {
            "key": "addOscillator",
            "label": "New oscillator",
            "nodeType": "oscillator"
          }
        ],
        "paletteCategories": [
          {
            "key": "seismic",
            "label": "Seismic",
            "icon": "∿"
          },
          {
            "key": "weather",
            "label": "Weather",
            "icon": "☁"
          },
          {
            "key": "tides",
            "label": "Tides",
            "icon": "≋"
          },
          {
            "key": "transform",
            "label": "Transform",
            "icon": "∼"
          },
          {
            "key": "mix",
            "label": "Mix",
            "icon": "▥"
          },
          {
            "key": "output",
            "label": "Output",
            "icon": "♪"
          }
        ],
        "patchTabs": [
          {
            "key": "pacific",
            "name": "Pacific Quake Patch",
            "active": true
          },
          {
            "key": "winds",
            "name": "Coastal Winds",
            "active": false
          },
          {
            "key": "tidal",
            "name": "Tidal Pulse",
            "active": false
          },
          {
            "key": "storm",
            "name": "Storm Rhythm",
            "active": false
          }
        ]
      },
      "connectorKinds": [
        {
          "key": "usgs_earthquakes",
          "label": "USGS Quakes",
          "description": "USGS GeoJSON summary feed (all_day by default). Same source as earthbeat v1.",
          "feedUrl": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
          "defaultPollIntervalMs": 60000,
          "defaultPlaybackHz": 4,
          "channels": [
            {
              "key": "mag",
              "label": "Magnitude",
              "unit": "magnitude",
              "valueType": "number",
              "source": "properties.mag",
              "modulatable": true,
              "min": 0,
              "max": 10,
              "mapHintMin": 1,
              "mapHintMax": 8
            },
            {
              "key": "depthKm",
              "label": "Depth",
              "unit": "km",
              "valueType": "number",
              "source": "geometry.coordinates[2]",
              "modulatable": true,
              "min": 0,
              "max": 700
            },
            {
              "key": "sig",
              "label": "Significance",
              "unit": "sig",
              "valueType": "number",
              "source": "properties.sig",
              "modulatable": true,
              "min": 0,
              "max": 1000
            },
            {
              "key": "place",
              "label": "Place",
              "valueType": "string",
              "source": "properties.place",
              "modulatable": false
            },
            {
              "key": "time",
              "label": "Event time",
              "valueType": "timestamp",
              "source": "properties.time",
              "modulatable": false,
              "description": "Unix time in milliseconds"
            },
            {
              "key": "eventId",
              "label": "Event id",
              "valueType": "string",
              "source": "id",
              "modulatable": false
            }
          ]
        }
      ],
      "oscillatorDefaults": {
        "waveform": "sine",
        "frequencyHz": 220,
        "gain": 0.2,
        "runtime": "elemaudio",
        "notes": "Matches earthbeat v1 Elementary WebRenderer sine (el.phasor + el.sin)."
      },
      "modulatorDefaults": {
        "channelKey": "mag",
        "targetParam": "frequencyHz",
        "inMin": 1,
        "inMax": 8,
        "outMin": 110,
        "outMax": 880
      }
    },
    "types": [
      {
        "name": "User",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "image",
            "type": "string"
          },
          {
            "name": "provider",
            "type": "string",
            "required": true
          },
          {
            "name": "providerSubject",
            "type": "string",
            "required": true
          },
          {
            "name": "createdAt",
            "type": "timestamp",
            "required": true
          },
          {
            "name": "updatedAt",
            "type": "timestamp",
            "required": true
          }
        ],
        "commands": [
          {
            "name": "upsertFromAuth",
            "parameters": [
              {
                "name": "email",
                "type": "string",
                "required": true
              },
              {
                "name": "name",
                "type": "string"
              },
              {
                "name": "image",
                "type": "string"
              },
              {
                "name": "provider",
                "type": "string",
                "required": true
              },
              {
                "name": "providerSubject",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Patch",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "userId",
            "type": "string",
            "required": true,
            "ref": "User"
          },
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "createdAt",
            "type": "timestamp",
            "required": true
          },
          {
            "name": "updatedAt",
            "type": "timestamp",
            "required": true
          }
        ],
        "commands": [
          {
            "name": "create",
            "parameters": [
              {
                "name": "name",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "rename",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "name",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "delete",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "ConnectorKind",
        "description": "Catalog entry for a natural-signal API kind. usgs_earthquakes channels mirror USGS GeoJSON summary fields used for sonification and display.",
        "fields": [
          {
            "name": "key",
            "type": "string",
            "required": true
          },
          {
            "name": "label",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "channels",
            "type": "array",
            "required": true,
            "of": {
              "name": "Channel",
              "fields": [
                {
                  "name": "key",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "label",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "unit",
                  "type": "string"
                },
                {
                  "name": "min",
                  "type": "number"
                },
                {
                  "name": "max",
                  "type": "number"
                }
              ]
            }
          }
        ],
        "commands": [
          {
            "name": "register",
            "parameters": [
              {
                "name": "key",
                "type": "string",
                "required": true
              },
              {
                "name": "label",
                "type": "string",
                "required": true
              },
              {
                "name": "description",
                "type": "string"
              },
              {
                "name": "channels",
                "type": "array",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Connector",
        "description": "Canvas node: live instance of a ConnectorKind. For usgs_earthquakes, config holds feed URL and poll/playback rates from earthbeat v1 stream options.",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "patchId",
            "type": "string",
            "required": true,
            "ref": "Patch"
          },
          {
            "name": "kindKey",
            "type": "string",
            "required": true,
            "ref": "ConnectorKind"
          },
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "positionX",
            "type": "number",
            "required": true
          },
          {
            "name": "positionY",
            "type": "number",
            "required": true
          },
          {
            "name": "feedUrl",
            "type": "string",
            "description": "USGS GeoJSON feed URL. Default is the ConnectorKind feedUrl (all_day)."
          },
          {
            "name": "pollIntervalMs",
            "type": "number",
            "default": 60000,
            "description": "How often to refetch the USGS feed."
          },
          {
            "name": "playbackHz",
            "type": "number",
            "default": 4,
            "description": "How many queued samples to emit per second (earthbeat v1 EarthquakeStream hz)."
          },
          {
            "name": "config",
            "type": "json"
          }
        ],
        "commands": [
          {
            "name": "add",
            "parameters": [
              {
                "name": "patchId",
                "type": "string",
                "required": true
              },
              {
                "name": "kindKey",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              },
              {
                "name": "label",
                "type": "string"
              },
              {
                "name": "config",
                "type": "json"
              },
              {
                "name": "feedUrl",
                "type": "string"
              },
              {
                "name": "pollIntervalMs",
                "type": "number",
                "default": 60000
              },
              {
                "name": "playbackHz",
                "type": "number",
                "default": 4
              }
            ]
          },
          {
            "name": "move",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "updateConfig",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "config",
                "type": "json",
                "required": true
              }
            ]
          },
          {
            "name": "remove",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Oscillator",
        "description": "Canvas node: sound generator via Elementary (@elemaudio/core + web-renderer). MVP waveform is sine only (phasor driven by frequencyHz).",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "patchId",
            "type": "string",
            "required": true,
            "ref": "Patch"
          },
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "positionX",
            "type": "number",
            "required": true
          },
          {
            "name": "positionY",
            "type": "number",
            "required": true
          },
          {
            "name": "waveform",
            "type": "string",
            "required": true,
            "enum": [
              "sine"
            ],
            "description": "Tone shape. Only sine is implemented in the Elementary graph for now."
          },
          {
            "name": "frequencyHz",
            "type": "number",
            "required": true,
            "modulatable": true,
            "label": "Frequency (Hz)",
            "min": 20,
            "max": 2000,
            "default": 220,
            "description": "Oscillator frequency in Hz. Drives el.phasor in the Elementary graph."
          },
          {
            "name": "gain",
            "type": "number",
            "required": true,
            "modulatable": true,
            "label": "Gain",
            "min": 0,
            "max": 1,
            "default": 0.2,
            "description": "Output amplitude scale (0 to 1)."
          }
        ],
        "commands": [
          {
            "name": "add",
            "parameters": [
              {
                "name": "patchId",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              },
              {
                "name": "waveform",
                "type": "string"
              },
              {
                "name": "frequencyHz",
                "type": "number"
              },
              {
                "name": "gain",
                "type": "number"
              },
              {
                "name": "label",
                "type": "string"
              }
            ]
          },
          {
            "name": "move",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "updateParams",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "waveform",
                "type": "string"
              },
              {
                "name": "frequencyHz",
                "type": "number"
              },
              {
                "name": "gain",
                "type": "number"
              },
              {
                "name": "label",
                "type": "string"
              }
            ]
          },
          {
            "name": "remove",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Modulator",
        "description": "Canvas node that maps a Channel value onto an Oscillator parameter. Wires between nodes are plain React Flow edges.",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "patchId",
            "type": "string",
            "required": true,
            "ref": "Patch"
          },
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "positionX",
            "type": "number",
            "required": true
          },
          {
            "name": "positionY",
            "type": "number",
            "required": true
          },
          {
            "name": "channelKey",
            "type": "string",
            "required": true
          },
          {
            "name": "targetParam",
            "type": "string",
            "required": true,
            "description": "Modulatable Oscillator field key, for example frequencyHz or gain."
          },
          {
            "name": "inMin",
            "type": "number",
            "required": true
          },
          {
            "name": "inMax",
            "type": "number",
            "required": true
          },
          {
            "name": "outMin",
            "type": "number",
            "required": true
          },
          {
            "name": "outMax",
            "type": "number",
            "required": true
          }
        ],
        "commands": [
          {
            "name": "add",
            "parameters": [
              {
                "name": "patchId",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              },
              {
                "name": "channelKey",
                "type": "string",
                "required": true
              },
              {
                "name": "targetParam",
                "type": "string",
                "required": true
              },
              {
                "name": "inMin",
                "type": "number"
              },
              {
                "name": "inMax",
                "type": "number"
              },
              {
                "name": "outMin",
                "type": "number"
              },
              {
                "name": "outMax",
                "type": "number"
              },
              {
                "name": "label",
                "type": "string"
              }
            ]
          },
          {
            "name": "move",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "updateMapping",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "channelKey",
                "type": "string"
              },
              {
                "name": "targetParam",
                "type": "string"
              },
              {
                "name": "inMin",
                "type": "number"
              },
              {
                "name": "inMax",
                "type": "number"
              },
              {
                "name": "outMin",
                "type": "number"
              },
              {
                "name": "outMax",
                "type": "number"
              },
              {
                "name": "label",
                "type": "string"
              }
            ]
          },
          {
            "name": "remove",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      }
    ]
  }
}
