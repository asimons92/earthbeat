{
  "name": "earthbeat",
  "generators": [
    "./generators/ui-catalog",
    "./generators/api"
  ],
  "model": {
    "catalog": {
      "shell": {
        "createActions": [
          {
            "key": "addConnector",
            "label": "New connector",
            "nodeType": "connector"
          },
          {
            "key": "addModulator",
            "label": "New modulator",
            "nodeType": "modulator"
          },
          {
            "key": "addEffect",
            "label": "New effect",
            "nodeType": "effect"
          },
          {
            "key": "addOscillator",
            "label": "New oscillator",
            "nodeType": "oscillator"
          }
        ],
        "patchTabs": [
          {
            "key": "pacific",
            "name": "Pacific Quake Patch",
            "active": true
          },
          {
            "key": "winds",
            "name": "Coastal Winds",
            "active": false
          },
          {
            "key": "tidal",
            "name": "Tidal Pulse",
            "active": false
          },
          {
            "key": "storm",
            "name": "Storm Rhythm",
            "active": false
          }
        ],
        "authActions": [
          {
            "key": "google_sign_in",
            "label": "Sign in with Google",
            "provider": "google",
            "path": "/api/auth/signin/google"
          },
          {
            "key": "sign_out",
            "label": "Sign out",
            "path": "/api/auth/signout"
          }
        ],
        "patchFileActions": [
          {
            "key": "new",
            "label": "New"
          },
          {
            "key": "save",
            "label": "Save"
          },
          {
            "key": "saveAs",
            "label": "Save As"
          },
          {
            "key": "delete",
            "label": "Delete"
          }
        ],
        "navItems": [
          {
            "key": "canvas",
            "label": "Canvas",
            "path": "/",
            "listSource": "none"
          },
          {
            "key": "connectorLibrary",
            "label": "Connector Library",
            "path": "/connectors",
            "listSource": "connectorKinds"
          },
          {
            "key": "effectLibrary",
            "label": "Effect Library",
            "path": "/effects",
            "listSource": "effectKinds"
          },
          {
            "key": "patchLibrary",
            "label": "Patch Library",
            "path": "/patches",
            "listSource": "patches"
          }
        ]
      },
      "connectorKinds": [
        {
          "key": "usgs_earthquakes",
          "label": "USGS Quakes",
          "description": "USGS GeoJSON summary feed (all_day by default). Same source as earthbeat v1.",
          "feedUrl": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
          "defaultPollIntervalMs": 60000,
          "defaultPlaybackHz": 4,
          "channels": [
            {
              "key": "mag",
              "label": "Magnitude",
              "unit": "magnitude",
              "valueType": "number",
              "source": "properties.mag",
              "modulatable": true,
              "min": 0,
              "max": 10,
              "mapHintMin": 1,
              "mapHintMax": 8
            },
            {
              "key": "depthKm",
              "label": "Depth",
              "unit": "km",
              "valueType": "number",
              "source": "geometry.coordinates[2]",
              "modulatable": true,
              "min": 0,
              "max": 700
            },
            {
              "key": "sig",
              "label": "Significance",
              "unit": "sig",
              "valueType": "number",
              "source": "properties.sig",
              "modulatable": true,
              "min": 0,
              "max": 1000
            },
            {
              "key": "place",
              "label": "Place",
              "valueType": "string",
              "source": "properties.place",
              "modulatable": false
            },
            {
              "key": "time",
              "label": "Event time",
              "valueType": "timestamp",
              "source": "properties.time",
              "modulatable": false,
              "description": "Unix time in milliseconds"
            },
            {
              "key": "eventId",
              "label": "Event id",
              "valueType": "string",
              "source": "id",
              "modulatable": false
            }
          ]
        },
        {
          "key": "noaa_coops_tides",
          "label": "NOAA Tides",
          "description": "NOAA CO-OPS water_level product (preliminary or verified 6-minute interval). Default station is San Francisco (9414290). Server polls about every six minutes and scrubs a 24h window into a slow ~120s loop.",
          "feedUrl": "https://api.tidesandcurrents.noaa.gov/api/prod/datagetter",
          "defaultPollIntervalMs": 360000,
          "defaultPlaybackHz": 1,
          "defaultConfig": {
            "station": "9414290",
            "product": "water_level",
            "datum": "MLLW",
            "units": "metric",
            "time_zone": "gmt",
            "format": "json",
            "application": "earthbeat",
            "interpolate": true
          },
          "channels": [
            {
              "key": "waterLevel",
              "label": "Water level",
              "unit": "m",
              "valueType": "number",
              "source": "data[].v",
              "modulatable": true,
              "min": -2,
              "max": 4,
              "mapHintMin": -1,
              "mapHintMax": 3
            },
            {
              "key": "time",
              "label": "Observation time",
              "valueType": "timestamp",
              "source": "data[].t",
              "modulatable": false,
              "description": "CO-OPS observation timestamp"
            },
            {
              "key": "stationId",
              "label": "Station id",
              "valueType": "string",
              "source": "metadata.id",
              "modulatable": false
            }
          ]
        }
      ],
      "oscillatorDefaults": {
        "waveform": "sine",
        "frequencyHz": 220,
        "gain": 0.2,
        "runtime": "elemaudio",
        "notes": "Matches earthbeat v1 Elementary WebRenderer sine (el.phasor + el.sin)."
      },
      "modulatorDefaults": {
        "channelKey": "mag",
        "targetParam": "frequencyHz",
        "inMin": 1,
        "inMax": 8,
        "outMin": 0.5,
        "outMax": 4
      },
      "effectKinds": [
        {
          "key": "scale_snap",
          "label": "Scale Snap",
          "description": "Snaps Oscillator Hertz to the nearest pitch in a tonic and named scale.",
          "transforms": ["frequencyHz"],
          "defaultTonic": "C",
          "defaultScaleKey": "major",
          "defaultEnabled": true,
          "a4Hz": 440
        },
        {
          "key": "distortion",
          "label": "Distortion",
          "description": "Soft-clip saturation on the Oscillator audio path (tanh drive).",
          "transforms": ["audio"],
          "defaultEnabled": true,
          "defaultDrive": 2
        },
        {
          "key": "delay",
          "label": "Delay",
          "description": "Feedback echo on the Oscillator audio path.",
          "transforms": ["audio"],
          "defaultEnabled": true,
          "defaultTimeMs": 250,
          "defaultFeedback": 0.35,
          "defaultMix": 0.35
        }
      ],
      "scaleSnapTonics": [
        { "key": "C", "label": "C" },
        { "key": "C#", "label": "C#" },
        { "key": "D", "label": "D" },
        { "key": "D#", "label": "D#" },
        { "key": "E", "label": "E" },
        { "key": "F", "label": "F" },
        { "key": "F#", "label": "F#" },
        { "key": "G", "label": "G" },
        { "key": "G#", "label": "G#" },
        { "key": "A", "label": "A" },
        { "key": "A#", "label": "A#" },
        { "key": "B", "label": "B" }
      ],
      "scaleSnapScales": [
        {
          "key": "major",
          "label": "Major",
          "degrees": [0, 2, 4, 5, 7, 9, 11]
        },
        {
          "key": "natural_minor",
          "label": "Natural minor",
          "degrees": [0, 2, 3, 5, 7, 8, 10]
        },
        {
          "key": "major_pentatonic",
          "label": "Major pentatonic",
          "degrees": [0, 2, 4, 7, 9]
        },
        {
          "key": "minor_pentatonic",
          "label": "Minor pentatonic",
          "degrees": [0, 3, 5, 7, 10]
        }
      ],
      "effectDefaults": {
        "kindKey": "scale_snap",
        "tonic": "C",
        "scaleKey": "major",
        "enabled": true,
        "a4Hz": 440,
        "drive": 2,
        "timeMs": 250,
        "feedback": 0.35,
        "mix": 0.35
      }
    },
    "types": [
      {
        "name": "User",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "email",
            "type": "string",
            "required": true
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "image",
            "type": "string"
          },
          {
            "name": "provider",
            "type": "string",
            "required": true
          },
          {
            "name": "providerSubject",
            "type": "string",
            "required": true
          },
          {
            "name": "createdAt",
            "type": "timestamp",
            "required": true
          },
          {
            "name": "updatedAt",
            "type": "timestamp",
            "required": true
          }
        ],
        "commands": [
          {
            "name": "upsertFromAuth",
            "parameters": [
              {
                "name": "email",
                "type": "string",
                "required": true
              },
              {
                "name": "name",
                "type": "string"
              },
              {
                "name": "image",
                "type": "string"
              },
              {
                "name": "provider",
                "type": "string",
                "required": true
              },
              {
                "name": "providerSubject",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Patch",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "userId",
            "type": "string",
            "required": true,
            "ref": "User"
          },
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "createdAt",
            "type": "timestamp",
            "required": true
          },
          {
            "name": "updatedAt",
            "type": "timestamp",
            "required": true
          },
          {
            "name": "version",
            "type": "number",
            "required": true,
            "default": 1,
            "description": "Optimistic concurrency token. Every write checks and bumps this value."
          }
        ],
        "commands": [
          {
            "name": "create",
            "parameters": [
              {
                "name": "name",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "rename",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "name",
                "type": "string",
                "required": true
              },
              {
                "name": "expectedVersion",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "delete",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "expectedVersion",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "list",
            "parameters": []
          },
          {
            "name": "get",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "replaceGraph",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "expectedVersion",
                "type": "number",
                "required": true
              },
              {
                "name": "connectors",
                "type": "json",
                "required": true,
                "description": "Full Connector rows for this Patch."
              },
              {
                "name": "modulators",
                "type": "json",
                "required": true,
                "description": "Full Modulator rows for this Patch."
              },
              {
                "name": "oscillators",
                "type": "json",
                "required": true,
                "description": "Full Oscillator rows for this Patch."
              },
              {
                "name": "effects",
                "type": "json",
                "required": true,
                "description": "Full Effect rows for this Patch."
              },
              {
                "name": "wires",
                "type": "json",
                "required": true,
                "description": "Full Wire rows for this Patch."
              }
            ]
          }
        ]
      },
      {
        "name": "ConnectorKind",
        "persist": false,
        "description": "Catalog entry for a natural-signal API kind. usgs_earthquakes channels mirror USGS GeoJSON summary fields used for sonification and display.",
        "fields": [
          {
            "name": "key",
            "type": "string",
            "required": true
          },
          {
            "name": "label",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "channels",
            "type": "array",
            "required": true,
            "of": {
              "name": "Channel",
              "fields": [
                {
                  "name": "key",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "label",
                  "type": "string",
                  "required": true
                },
                {
                  "name": "unit",
                  "type": "string"
                },
                {
                  "name": "min",
                  "type": "number"
                },
                {
                  "name": "max",
                  "type": "number"
                }
              ]
            }
          }
        ],
        "commands": [
          {
            "name": "register",
            "parameters": [
              {
                "name": "key",
                "type": "string",
                "required": true
              },
              {
                "name": "label",
                "type": "string",
                "required": true
              },
              {
                "name": "description",
                "type": "string"
              },
              {
                "name": "channels",
                "type": "array",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Connector",
        "description": "Canvas node: live instance of a ConnectorKind. For usgs_earthquakes, config holds feed URL and poll/playback rates from earthbeat v1 stream options.",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "patchId",
            "type": "string",
            "required": true,
            "ref": "Patch"
          },
          {
            "name": "kindKey",
            "type": "string",
            "required": true,
            "ref": "ConnectorKind"
          },
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "positionX",
            "type": "number",
            "required": true
          },
          {
            "name": "positionY",
            "type": "number",
            "required": true
          },
          {
            "name": "feedUrl",
            "type": "string",
            "description": "USGS GeoJSON feed URL. Default is the ConnectorKind feedUrl (all_day)."
          },
          {
            "name": "pollIntervalMs",
            "type": "number",
            "default": 60000,
            "description": "How often to refetch the USGS feed."
          },
          {
            "name": "playbackHz",
            "type": "number",
            "default": 4,
            "description": "How many queued samples to emit per second (earthbeat v1 EarthquakeStream hz)."
          },
          {
            "name": "config",
            "type": "json"
          }
        ],
        "commands": [
          {
            "name": "add",
            "parameters": [
              {
                "name": "patchId",
                "type": "string",
                "required": true
              },
              {
                "name": "kindKey",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              },
              {
                "name": "label",
                "type": "string"
              },
              {
                "name": "config",
                "type": "json"
              },
              {
                "name": "feedUrl",
                "type": "string"
              },
              {
                "name": "pollIntervalMs",
                "type": "number",
                "default": 60000
              },
              {
                "name": "playbackHz",
                "type": "number",
                "default": 4
              }
            ]
          },
          {
            "name": "move",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "updateConfig",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "config",
                "type": "json",
                "required": true
              }
            ]
          },
          {
            "name": "remove",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "Oscillator",
        "description": "Canvas node: sound generator via Elementary (@elemaudio/core + web-renderer). Waveforms: sine, square, saw, noise.",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "patchId",
            "type": "string",
            "required": true,
            "ref": "Patch"
          },
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "positionX",
            "type": "number",
            "required": true
          },
          {
            "name": "positionY",
            "type": "number",
            "required": true
          },
          {
            "name": "waveform",
            "type": "string",
            "required": true,
            "enum": [
              "sine",
              "square",
              "saw",
              "noise"
            ],
            "description": "Tone shape. Sine uses phasor+sin; square and saw use blep oscillators; noise is white and ignores frequencyHz."
          },
          {
            "name": "frequencyHz",
            "type": "number",
            "required": true,
            "modulatable": true,
            "label": "Frequency (Hz)",
            "min": 20,
            "max": 2000,
            "default": 220,
            "modulationKind": "ratio",
            "modulationOutMin": 0.5,
            "modulationOutMax": 4,
            "description": "Oscillator base frequency in Hz. Modulators that target this field multiply it by a mapped ratio."
          },
          {
            "name": "gain",
            "type": "number",
            "required": true,
            "modulatable": true,
            "label": "Gain",
            "min": 0,
            "max": 1,
            "default": 0.2,
            "modulationKind": "absolute",
            "modulationOutMin": 0,
            "modulationOutMax": 1,
            "description": "Output amplitude scale (0 to 1)."
          }
        ],
        "commands": [
          {
            "name": "add",
            "parameters": [
              {
                "name": "patchId",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              },
              {
                "name": "waveform",
                "type": "string"
              },
              {
                "name": "frequencyHz",
                "type": "number"
              },
              {
                "name": "gain",
                "type": "number"
              },
              {
                "name": "label",
                "type": "string"
              }
            ]
          },
          {
            "name": "move",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "positionX",
                "type": "number",
                "required": true
              },
              {
                "name": "positionY",
                "type": "number",
                "required": true
              }
            ]
          },
          {
            "name": "updateParams",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              },
              {
                "name": "waveform",
                "type": "string"
              },
              {
                "name": "frequencyHz",
                "type": "number"
              },
              {
                "name": "gain",
                "type": "number"
              },
              {
                "name": "label",
                "type": "string"
              }
            ]
          },
          {
            "name": "remove",
            "parameters": [
              {
                "name": "id",
                "type": "string",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "name": "EffectKind",
        "persist": false,
        "description": "Catalog entry for an Effect kind. Control kinds transform frequencyHz into an Oscillator. Audio kinds transform Oscillator audio before the mix.",
        "fields": [
          {
            "name": "key",
            "type": "string",
            "required": true
          },
          {
            "name": "label",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "transforms",
            "type": "array",
            "required": true
          }
        ]
      },
      {
        "name": "Effect",
        "description": "Canvas node: control transform into an Oscillator (scale_snap) or audio transform after an Oscillator (distortion, delay).",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true
          },
          {
            "name": "patchId",
            "type": "string",
            "required": true,
            "ref": "Patch"
          },
          {
            "name": "kindKey",
            "type": "string",
            "required": true,
            "ref": "EffectKind"
          },
          {
            "name": "label",
            "type": "string"
          },
          {
            "name": "positionX",
            "type": "number",
            "required": true
          },
          {
            "name": "positionY",
            "type": "number",
            "required": true
          },
          {
            "name": "tonic",
            "type": "string",
            "required": true,
            "default": "C",
            "description": "Scale tonic pitch class (C through B, sharps)."
          },
          {
            "name": "scaleKey",
            "type": "string",
            "required": true,
            "default": "major",
            "description": "Named scale key from catalog.scaleSnapScales."
          },
          {
            "name": "enabled",
            "type": "boolean",
            "required": true,
            "default": true,
            "description": "Pedal-style bypass. When false, the Effect passes the signal through unchanged."
          },
          {
            "name": "a4Hz",
            "type": "number",
            "required": true,
            "default": 440,
            "description": "Equal-temperament A4 reference in Hertz."
          },
          {
            "name": "drive",
            "type": "number",
            "required": true,
            "default": 2,
            "description": "Distortion drive into tanh soft clip."
          },
          {
            "name": "timeMs",
            "type": "number",
            "required": true,
            "default": 250,
            "description": "Delay time in milliseconds."
          },
          {
            "name": "feedback",
            "type": "number",
            "required": true,
            "default": 0.35,
            "description": "Delay feedback coefficient."
          },
