# Copy to .env and fill in values as needed.
DATABASE_URL=postgres://earthbeat:earthbeat@localhost:5432/earthbeat
PORT=3001
# Production (Railway): leave unset so Express serves ../client/dist.
# CLIENT_DIST=
# NODE_ENV=production
# Production requires AUTH_MODE=google plus AUTH_SECRET and Google client credentials.
AUTH_MODE=local
# AUTH_MODE=google
# AUTH_SECRET=replace-me
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_URL must be the public origin only (no /api/auth path).
# Example: https://earthbeat-production.up.railway.app
# AUTH_URL=http://localhost:5173
# AUTH_TRUST_HOST=true
LOCAL_USER_EMAIL=dev@earthbeat.local
LOCAL_USER_NAME=Local Dev
