{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-clay-generated.js",
        "matcher": "Write|Delete|StrReplace|EditNotebook",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/block-clay-generated.js",
        "matcher": "Shell",
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/review-typecheck.js",
        "matcher": "Task",
        "failClosed": false,
        "timeout": 120
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-clay-generated.js",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/review-typecheck.js",
        "failClosed": false,
        "timeout": 120
      }
    ]
  }
}
